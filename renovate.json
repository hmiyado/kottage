{
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "14 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "actions.lock検証に使うgh-actions-lock拡張の版を追従させる",
      "managerFilePatterns": ["/^\\.github/workflows/actions-lock-verify\\.yml$/"],
      "matchStrings": [
        "ACTIONS_LOCK_EXT_VERSION:\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "automerge": true,
      "matchFileNames": [
        "backend/**"
      ],
      "matchPackageNames": [
        "/.*/"
      ]
    },
    {
      "automerge": true,
      "matchFileNames": [
        "package.json",
        "frontend/package.json"
      ],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "matchManagers": ["terraform"],
      "enabled": false
    },
    {
      "description": "actionsの更新PRはmainから遅れたら作り直し、actions.lockを常に最新のmainに対して再生成させる",
      "matchManagers": ["github-actions"],
      "rebaseWhen": "behind-base-branch"
    }
  ],
  "ignoreDeps": ["openjdk"],
  "platformCommit": "enabled",
  "cloneSubmodules": false,
  "toolSettings": {
    "nodeMaxMemory": 2048
  }
}
